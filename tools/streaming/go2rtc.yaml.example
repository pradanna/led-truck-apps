# go2rtc WebRTC & RTSP Gateway Configuration Template
# This file is automatically generated and synchronized at runtime by HolowitsService.php

api:
  listen: ":1984"
  origin: "*"

rtsp:
  listen: ":8554"

webrtc:
  listen: ":8555"

streams:
  # Generated dynamically from SystemSettings / Holowits Service
  truck_1_ch1:
    - rtsp://admin:password@127.0.0.1:554/rtsp/streaming?channel=1&subtype=0#backchannel=0
  truck_1_ch2:
    - rtsp://admin:password@127.0.0.1:554/rtsp/streaming?channel=2&subtype=0#backchannel=0
  truck_2_ch1:
    - rtsp://admin:password@127.0.0.1:554/rtsp/streaming?channel=1&subtype=0#backchannel=0
  truck_2_ch2:
    - rtsp://admin:password@127.0.0.1:554/rtsp/streaming?channel=2&subtype=0#backchannel=0
